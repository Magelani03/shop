{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shop-api",
	"main": "server/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"JWT_SECRET": "your-secret-here",
		"ADMIN_WHATSAPP": "+1234567890"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shop-db-v2",
			"database_id": "41d4530f-8094-4988-8b85-fa060c8bbb2a"
		},
		{
			"binding": "Shop",
			"database_name": "Shop",
			"database_id": "41d4530f-8094-4988-8b85-fa060c8bbb2a",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	}
}